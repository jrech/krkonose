# Canonical production URL, also used for sitemap.xml and robots.txt.
SITE_URL=https://www.pradelnakrkonose.cz
# Server-only Mapy.com REST API key. Configure as a Zerops secret, never PUBLIC_.
MAPY_API_KEY=
# Inquiry endpoint (POST JSON). Optional override of the Formspree form in src/data/site.ts, e.g. a test form.
PUBLIC_INQUIRY_ENDPOINT=
# Optional override of the GA4 measurement ID in src/data/site.ts (G-XXXXXXXXXX), or "off" to disable GA.
# GA loads only after the visitor consents to analytics.
PUBLIC_GA_ID=
