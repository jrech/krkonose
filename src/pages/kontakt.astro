---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactHeader from '../components/contact/ContactHeader.astro';
import InquiryForm from '../components/contact/InquiryForm.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/ui/Icon.astro';
import ConsentEmbed from '../components/consent/ConsentEmbed.astro';
import { addressLine, site } from '../data/site';

// No response time is promised until the owner confirms it (WEBSITE_SPEC §6).
const nextSteps = ['Pošlete základní údaje', 'Probereme rozsah a místo svozu', 'Domluvíme konkrétní podmínky'];

// The embed sets Google cookies, so it loads only after consent (components/consent/ConsentEmbed).
const address = addressLine;
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&z=15&hl=cs&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---
<BaseLayout title="Kontakt a poptávka | Prádelna Krkonoše" description="Nezávazně poptejte praní a svoz prádla pro hotel, penzion, chalupu nebo gastro provoz v Krkonoších. Napište nám nebo zavolejte.">
  <ContactHeader />
  <main id="main">
    <section class="contact-intro container" aria-labelledby="contact-title">
      <p class="eyebrow" data-reveal>Kontakt / Poptávka</p>
      <div class="intro-row">
        <h1 id="contact-title" data-reveal="heading"><span class="reveal-line">Řekněte nám,</span> <span class="reveal-line">co potřebujete prát.</span></h1>
        <p class="lead" data-reveal>Napište nám, kde podnikáte a co potřebujete prát. Ozveme se a společně doladíme rozsah i svoz.</p>
      </div>
    </section>

    <section class="contact-body container" aria-label="Poptávka a přímý kontakt">
      <div data-reveal="card"><InquiryForm /></div>
      <aside class="contact-side" data-reveal="card">
        <div class="direct">
          <p class="eyebrow">Raději přímo?</p>
          <h2 id="direct-title">Zavolejte nebo napište.</h2>
          <dl>
            <div><dt>Telefon</dt><dd><a class="direct-phone" href={site.phoneHref}>{site.phone}</a></dd></div>
            <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          </dl>
          <p class="direct-area"><Icon name="map-pin" />{site.area}</p>
        </div>
        <div class="next-steps">
          <h2 id="next-title">Co bude dál</h2>
          <ol aria-labelledby="next-title">{nextSteps.map((step, i) => <li><span>0{i + 1}</span>{step}</li>)}</ol>
        </div>
      </aside>
    </section>

    <section class="location container" aria-label="Poloha prádelny" data-reveal>
      <div class="map-frame">
        <ConsentEmbed category="maps" src={mapEmbed} title={`Mapa Google: ${address}`} text="Mapa Google se načte až s vaším souhlasem, protože Google při tom ukládá cookies." button="Načíst mapu" />
      </div>
      <p class="map-caption"><span>{address}</span><a class="text-link" href={mapLink} target="_blank" rel="noopener">Otevřít v Google Mapách</a></p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .contact-intro { padding-block: 80px; --reveal-base: var(--header-entrance); }
  .contact-intro .eyebrow { margin-bottom: 24px; }
  .intro-row { display: grid; grid-template-columns: minmax(0, 1fr) 336px; align-items: end; gap: 80px; }
  h1 { font-size: var(--text-display); line-height: 1.05; letter-spacing: -.0245em; font-weight: 500; }
  .contact-body { display: grid; grid-template-columns: minmax(0, 860fr) minmax(320px, 420fr); align-items: start; gap: 32px; padding-bottom: clamp(48px, 5.6vw, 80px); }
  .location { padding-bottom: var(--section-space); }
  .map-frame { position: relative; height: clamp(320px, 30.5vw, 439px); border-radius: 12px; overflow: hidden; background: var(--pk-line); }
  .map-caption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; padding-top: 16px; color: var(--pk-muted); font-size: 14px; line-height: 20px; }
  .contact-side { display: grid; gap: 32px; }
  .direct { display: grid; gap: 24px; padding: 32px; border-radius: 12px; background: var(--pk-deep-teal); color: var(--pk-white); }
  .direct .eyebrow { margin: 0; color: var(--pk-yellow); }
  .direct .eyebrow::before { background: var(--pk-yellow); }
  .direct h2, .next-steps h2 { font-size: 32px; line-height: 1.19; letter-spacing: -.035em; }
  dl { display: grid; gap: 24px; margin: 0; padding-top: 24px; border-top: 1px solid #ffffff33; }
  dl div { display: grid; gap: 8px; }
  dt { font-size: 12px; line-height: 17px; letter-spacing: 1px; text-transform: uppercase; color: var(--pk-dark-muted); }
  dd { margin: 0; }
  /* Padding grows the hit area to the 24 px WCAG 2.2 minimum; the negative margin keeps the layout. */
  dd a { text-decoration: none; overflow-wrap: anywhere; padding-block: 4px; }
  .map-caption a { padding-block: 4px; margin-block: -4px; }
  dd a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .direct-phone { font-size: 24px; line-height: 31px; font-weight: 500; letter-spacing: -.035em; }
  .direct :focus-visible { outline-color: var(--pk-yellow); }
  .direct-area { display: flex; align-items: center; gap: 8px; padding-top: 24px; border-top: 1px solid #ffffff33; color: var(--pk-dark-muted); font-size: 14px; line-height: 20px; }
  .direct-area :global(.icon) { width: 18px; height: 18px; }
  .next-steps { display: grid; gap: 16px; padding-inline: 8px; }
  .next-steps h2 { font-size: 24px; line-height: 1.3; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: 12px; padding-block: 8px; }
  li span { flex: 0 0 32px; height: 32px; display: grid; place-items: center; border-radius: 8px; background: #087f8614; color: var(--pk-teal); font-size: 12px; line-height: 17px; }
  @media (max-width: 1100px) {
    .contact-body { grid-template-columns: 1fr; }
    .contact-side { grid-template-columns: 1fr 1fr; align-items: start; }
  }
  @media (max-width: 900px) {
    .contact-intro { padding-block: 64px 48px; }
    .intro-row { grid-template-columns: 1fr; gap: 24px; }
    h1 { font-size: clamp(44px, 8vw, 64px); line-height: 1.1; }
  }
  @media (max-width: 760px) {
    .contact-side { grid-template-columns: 1fr; }
    .direct { padding: 24px; }
    .direct h2 { font-size: 28px; }
  }
</style>
