---
import arrowUpRight from '../../assets/icons/arrow-up-right.svg?raw';
import arrowRight from '../../assets/icons/arrow-right.svg?raw';
import phone from '../../assets/icons/phone.svg?raw';
import mail from '../../assets/icons/mail.svg?raw';
import truck from '../../assets/icons/truck.svg?raw';
import washingMachine from '../../assets/icons/washing-machine.svg?raw';
import packageCheck from '../../assets/icons/package-check.svg?raw';
import mapPin from '../../assets/icons/map-pin.svg?raw';
import plus from '../../assets/icons/plus.svg?raw';
import menu from '../../assets/icons/menu.svg?raw';
import close from '../../assets/icons/x.svg?raw';
import shirt from '../../assets/icons/shirt.svg?raw';
import clipboardCheck from '../../assets/icons/clipboard-check.svg?raw';
import calendarClock from '../../assets/icons/calendar-clock.svg?raw';
import search from '../../assets/icons/search.svg?raw';
const icons = { 'arrow-up-right': arrowUpRight, 'arrow-right': arrowRight, phone, mail, truck, 'washing-machine': washingMachine, 'package-check': packageCheck, 'map-pin': mapPin, plus, menu, close, shirt, 'clipboard-check': clipboardCheck, 'calendar-clock': calendarClock, search };
export type IconName = keyof typeof icons;
interface Props { name: IconName; class?: string }
const { name, class: className } = Astro.props;
// Keep license comments and editor metadata out of the inlined markup.
const svg = icons[name].replace(/<!--[\s\S]*?-->|<metadata>[\s\S]*?<\/metadata>/g, '').trim();
---
<span class:list={['icon', className]} aria-hidden="true" set:html={svg} />
<style>.icon { display: inline-flex; flex: 0 0 auto; width: 24px; height: 24px; } .icon :global(svg) { width: 100%; height: 100%; stroke-width: 1.7; }</style>
