---
import Icon from './Icon.astro';
interface Props { href: string; secondary?: boolean; arrow?: boolean; segment?: string; class?: string; style?: string }
const { href, secondary = false, arrow = true, segment, class: className, style } = Astro.props;
---
<a class:list={['button', { 'button--secondary': secondary }, className]} href={href} data-segment={segment} style={style}>
  <span class="button-label"><span class="button-label-text"><slot /></span></span>{arrow && <Icon name="arrow-up-right" />}
</a>
