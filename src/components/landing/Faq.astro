---
import { faqs } from '../../data/site';
import Icon from '../ui/Icon.astro';
---
<section class="section faq" aria-labelledby="faq-title"><div class="container faq-layout">
  <div class="faq-intro"><h2 id="faq-title" data-reveal="heading">Před prvním svozem.</h2><p class="lead" data-reveal>Odpovědi na to, co provozy řeší nejčastěji. Konkrétní podmínky potvrdíme při poptávce.</p></div>
  <div class="faq-list" data-reveal="card">{faqs.map((faq, i) => <details data-rule="bottom" name="faq" open={i === 0}><summary>{faq.question}<span class="faq-toggle"><Icon name="ph-plus" class="faq-plus" /><Icon name="ph-minus" class="faq-minus" /></span></summary><p>{faq.answer}</p></details>)}</div>
</div></section>
<style>
  /* krkonose_new: centred introduction above one white card; rows split by hairlines, the open row
     warms to a pale gold. */
  .faq { background: var(--pk-paper); padding-block: var(--section-space-s); }
  .faq-layout { display: grid; justify-items: center; gap: clamp(40px, 5vw, 72px); }
  .faq-intro { text-align: center; max-width: 660px; }
  h2 { margin-bottom: 20px; }
  .faq .lead { font-size: 17px; line-height: 1.6; max-width: 38ch; margin-inline: auto; }
  .faq-list { width: 100%; max-width: 1284px; background: var(--pk-white); border: 1px solid var(--card-line); border-radius: var(--card-radius); overflow: hidden; }
  details { --rule-color: #e1e8e2; border-bottom: 1px solid #e1e8e2; transition: background-color var(--motion-fast) var(--ease-out); }
  details:last-child { --rule-color: transparent; border-bottom: 0; }
  details[open] { background: #fff9eb; --rule-color: #eaddbe; border-bottom-color: #eaddbe; }
  details[open]:last-child { --rule-color: transparent; }
  summary { list-style: none; cursor: pointer; padding: 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; color: #173d3b; font-size: 21px; line-height: 1.3; letter-spacing: -.02em; font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  details[open] summary { padding-bottom: 16px; font-weight: 600; }
  .faq-toggle { flex: 0 0 36px; height: 36px; display: grid; place-items: center; color: #3d6b63; }
  .faq-toggle :global(.icon) { grid-area: 1 / 1; width: 16px; height: 16px; transition: opacity var(--motion-fast) var(--ease-out), transform var(--motion-fast) var(--ease-out); }
  .faq-toggle :global(.faq-minus), details[open] .faq-toggle :global(.faq-plus) { opacity: 0; transform: rotate(-90deg); }
  details[open] .faq-toggle :global(.faq-minus) { opacity: 1; transform: none; }
  details p { padding: 0 84px 28px 28px; color: #5a7068; font-size: 16px; line-height: 1.625; }
  summary { transition: color var(--motion-fast) var(--ease-out); }
  @media (hover: hover) { summary:hover { color: var(--pk-teal); } }
  summary:focus-visible { outline-offset: -3px; }
  /* Answers open and close smoothly where the browser can size to auto; elsewhere they toggle. */
  @supports (interpolate-size: allow-keywords) {
    details { interpolate-size: allow-keywords; }
    details::details-content { block-size: 0; overflow-y: clip; transition: block-size 360ms var(--ease-out), content-visibility 360ms allow-discrete; }
    details[open]::details-content { block-size: auto; }
  }
  @media (max-width: 760px) {
    summary { font-size: 18px; padding: 20px; gap: 12px; }
    details[open] summary { padding-bottom: 8px; }
    details p { padding: 0 20px 24px; font-size: 15px; }
  }
</style>
