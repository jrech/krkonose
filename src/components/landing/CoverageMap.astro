---
// Illustrative regional map. Geography only: it never shows or implies the service boundary.
// Towns are interactive (status from src/data/service-area.ts, behaviour in src/lib/coverage/map-hotspots.ts).
import { mapFrame, projectToMap } from '../../data/map/frame';
import { landPath, stateBorderPath, regionBoundaryPath, contours } from '../../data/map/krkonose-geometry';
import { mapLabels } from '../../data/map/places';
import { getPlaceViews, placeGroupLabel } from '../../lib/coverage/place-view';
import CoverageMapTooltip from './CoverageMapTooltip.astro';

interface Props { class?: string }
const { class: className } = Astro.props;
const { width, height } = mapFrame;
const country = projectToMap(mapLabels.country.lon, mapLabels.country.lat);
const places = getPlaceViews().map(place => ({ ...place, ...projectToMap(place.lon, place.lat) }));
const placeNames = places.map(place => place.name).join(', ');
const LABEL_GAP = 12;
---
<figure class:list={['coverage-map', className]} data-reveal="card" data-coverage-map>
  <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid slice" role="group" aria-labelledby="coverage-map-title" aria-describedby="coverage-map-desc">
    <title id="coverage-map-title">Orientační mapa Krkonoš a Podkrkonoší</title>
    <desc id="coverage-map-desc">Česko-polská hranice, horský reliéf a města {placeNames}. Vrchlabí je zvýrazněné jako sídlo prádelny. Mapa neukazuje svozovou oblast.</desc>
    <rect class="map-abroad" width={width} height={height} />
    <path class="map-land" d={landPath} />
    <g class="map-relief">
      {contours.map(({ elevation, d }) => <path class:list={{ 'is-index': elevation % 500 === 0 }} d={d} />)}
    </g>
    <path class="map-region" d={regionBoundaryPath} />
    <path class="map-border" d={stateBorderPath} />
    <text class="map-country" x={country.x} y={country.y}>{mapLabels.country.text}</text>
    <g class="map-places" role="group" aria-label={placeGroupLabel}>
      {places.map(place => {
        const side = place.label;
        return (
          <g class:list={['map-place', { 'is-primary': place.primary, 'compact-below': place.compactLabel === 'below' }]} transform={`translate(${place.x.toFixed(1)} ${place.y.toFixed(1)})`} role="button" tabindex="0" aria-pressed="false" aria-label={place.accessibleName} data-place={place.id} data-name={place.name} data-status={place.status} data-status-label={place.statusLabel}>
            <circle class="map-hit" r="34" />
            <circle class="map-focus" r="15" />
            {place.primary && <circle class="map-halo" r="11" />}
            <circle class="map-glow" r="11" />
            <circle class="map-dot" r="4" data-anchor />
            <text class:list={{ 'name-full': place.compactName }} x={side === 'left' ? -LABEL_GAP : LABEL_GAP} y="5" text-anchor={side === 'left' ? 'end' : 'start'} aria-hidden="true">{place.name}</text>
            {place.compactName && <text class="name-compact" x={side === 'left' ? -LABEL_GAP : LABEL_GAP} y="5" text-anchor={side === 'left' ? 'end' : 'start'} aria-hidden="true">{place.compactName}</text>}
          </g>
        );
      })}
    </g>
  </svg>
  <p class="map-title" aria-hidden="true">{mapLabels.title}</p>
  <CoverageMapTooltip />
  <figcaption class="map-note">{mapLabels.note} <span>{mapLabels.attribution}</span></figcaption>
</figure>
<style>
  .coverage-map { position: relative; margin: 0; width: 100%; border-radius: 8px; background: var(--pk-paper); overflow: hidden; }
  .coverage-map svg { display: block; width: 100%; height: auto; aspect-ratio: 736 / 536; }
  .map-abroad { fill: #e9eeea; }
  .map-land { fill: var(--pk-paper); }
  .map-relief path { fill: none; stroke: #9db1a7; stroke-opacity: .28; stroke-width: .75; vector-effect: non-scaling-stroke; }
  .map-relief path.is-index { stroke-opacity: .42; }
  .map-region { fill: none; stroke: #c4d0c9; stroke-width: 1; stroke-dasharray: 3 4; vector-effect: non-scaling-stroke; }
  .map-border { fill: none; stroke: #aebdb5; stroke-width: 1.25; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .map-country, .map-place text { font-family: var(--font-sans); }
  .map-country { fill: #7e9189; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }
  .map-hit { fill: transparent; }
  .map-dot { fill: #8b9d94; transition: fill 200ms ease, transform 200ms var(--ease-out); }
  .map-halo { fill: color-mix(in srgb, var(--pk-deep-teal) 12%, transparent); }
  .map-place .name-compact { display: none; }
  .map-place text { fill: var(--pk-muted); font-size: 14px; paint-order: stroke; stroke: var(--pk-paper); stroke-width: 3px; stroke-linejoin: round; transition: fill 200ms ease; }
  .map-place.is-primary .map-dot { fill: var(--pk-deep-teal); }
  .map-place.is-primary text { fill: var(--pk-ink); font-weight: 500; }
  .map-place { cursor: pointer; outline: none; -webkit-tap-highlight-color: transparent; }
  .map-dot, .map-glow { transform-box: fill-box; transform-origin: center; }
  .map-glow { fill: var(--pk-yellow); opacity: 0; transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out); }
  .map-focus { fill: none; stroke: var(--pk-teal); stroke-width: 2.5; opacity: 0; }
  .map-place:focus-visible .map-focus { opacity: 1; }
  .map-place:focus-visible .map-dot { fill: var(--pk-deep-teal); transform: scale(1.35); }
  .map-place:focus-visible .map-glow { opacity: .45; }
  .map-place:focus-visible text, .map-place.is-selected text { fill: var(--pk-ink); }
  .map-place.is-selected .map-dot { fill: var(--pk-ink); transform: scale(1.35); }
  .map-place.is-selected .map-glow { opacity: .8; transform: scale(1.1); }
  /* Hover only where it exists; on touch a tap selects instead of leaving a sticky hover. */
  @media (hover: hover) {
    .map-place:hover .map-dot { fill: var(--pk-deep-teal); transform: scale(1.35); }
    .map-place.is-selected:hover .map-dot { fill: var(--pk-ink); }
    .map-place:hover:not(.is-selected) .map-glow { opacity: .45; }
    .map-place:hover text { fill: var(--pk-ink); }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-dot, .map-glow, .map-place text { transition: none; }
    .map-place .map-dot, .map-place .map-glow { transform: none !important; }
  }
  .map-title, .map-note { position: absolute; margin: 0; color: var(--pk-muted); pointer-events: none; }
  .map-title { top: 28px; left: 32px; font-size: 12px; line-height: 16px; letter-spacing: .08em; text-transform: uppercase; }
  .map-note { left: 32px; right: 32px; bottom: 24px; font-size: 12px; line-height: 1.4; }
  .map-note span { opacity: .8; }
  /* Reveal: the land settles in first, places follow once it is in place. */
  :global(.motion) .coverage-map.is-revealed .map-places { animation: map-places 600ms var(--ease-out) calc(var(--rv-delay, 0ms) + 450ms) both; }
  @keyframes map-places { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 760px) {
    /* Square crop of the centre (slice); labels grow so they stay ~13 px on screen. */
    .coverage-map svg { aspect-ratio: 1 / 1; max-height: 440px; }
    .map-place text { font-size: 20px; stroke-width: 5px; }
    .map-place.compact-below text { text-anchor: middle; transform: translate(12px, 26px); }
    .map-place .name-full { display: none; }
    .map-place .name-compact { display: inline; }
    .map-country { font-size: 17px; }
    .map-dot { r: 6px; }
    .map-halo, .map-glow { r: 16px; }
    .map-focus { r: 21px; }
    .map-title { top: 16px; left: 16px; }
    .map-note { position: static; padding: 12px 16px 14px; border-top: 1px solid var(--pk-line); font-size: 12px; }
    .map-note span { display: block; }
  }
</style>
