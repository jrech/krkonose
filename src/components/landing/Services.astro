---
import { services } from '../../data/site';
import Icon from '../ui/Icon.astro';
---
<section class="services" id="sluzby" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading"><h2 id="services-title" data-reveal="heading"><span class="reveal-line">Prádlo nechte na nás.</span> <span class="reveal-line">Vy se věnujte hostům.</span></h2></div>
    <div class="service-grid">{services.map(service => <article data-reveal="card"><span class="tile"><Icon name={service.icon} /></span><h3>{service.title}</h3><p>{service.text}</p></article>)}</div>
  </div>
</section>
<style>
  .services { background: var(--pk-white); padding-block: var(--section-space); }
  .section-heading h2 { margin-bottom: 0; }
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 6.7vw, 96px); margin-top: clamp(48px, 6.7vw, 96px); }
  article { padding-block: 32px; }
  .tile { margin-bottom: 24px; }
  h3 { font-size: 32px; line-height: 1.19; margin-bottom: 8px; letter-spacing: -.03em; }
  article p { color: var(--pk-muted); max-width: 34ch; font-size: 18px; line-height: 1.55; }
  @media (max-width: 900px) { .service-grid { gap: 32px; } }
  @media (max-width: 600px) {
    .service-grid { grid-template-columns: 1fr; gap: 0; margin-top: 40px; }
    article { padding-block: 24px; }
    .tile { margin-bottom: 20px; }
    article p { font-size: 16px; }
  }
</style>
