---
import { Image } from 'astro:assets';
import delivery from '../../assets/images/delivery.webp';
import { quality } from '../../data/site';
import Icon from '../ui/Icon.astro';
---
<section class="quality" aria-labelledby="quality-title">
  <div class="container quality-layout">
  <figure class="quality-photo" data-reveal="image"><Image src={delivery} alt="Ilustrační fotografie složeného prádla na vozíku připraveného k naložení do dodávky" widths={[480, 720, 1080]} sizes="(max-width: 900px) calc(100vw - 40px), 45vw" format="webp" loading="lazy" /><figcaption><span aria-hidden="true"></span>Každodenní provoz</figcaption></figure>
  <div><p class="eyebrow" data-reveal>05 / Spolupráce</p><h2 id="quality-title" data-reveal="heading"><span class="reveal-line">Spolehlivý servis,</span> <span class="reveal-line">na který se můžete připravit.</span></h2><p class="intro" data-reveal>Pravidelný svoz, profesionální péče o prádlo a spolupráce přizpůsobená vašemu provozu.</p>
    <ul>{quality.map((item, i) => <li data-reveal="card" style={`--item: ${i}`}><span class="quality-icon"><Icon name={item.icon} /></span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ul>
  </div>
  </div>
</section>
<style>
  .quality { background: var(--pk-deep-teal); color: var(--pk-white); padding-block: var(--section-space-l); overflow: hidden; }
  .quality-layout { display: grid; grid-template-columns: minmax(0, 632fr) minmax(0, 616fr); align-items: center; gap: clamp(40px, 4.5vw, 64px); }
  /* The photo sits first in the DOM but follows the heading on screen. */
  .quality-photo { --rv-radius: 12px; --reveal-delay: calc(var(--motion-stagger) * 2); position: relative; margin: 0; height: 100%; min-height: 480px; max-height: 620px; border-radius: 12px; overflow: hidden; outline: 1px solid #ffffff1f; outline-offset: -.5px; }
  .quality-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  figcaption { position: absolute; left: 16px; top: 16px; display: flex; align-items: center; gap: 16px; padding: 8px 16px; border-radius: 6px; background: var(--pk-deep-teal); font-size: 12px; line-height: 17px; letter-spacing: .08em; text-transform: uppercase; }
  figcaption span { width: 6px; height: 6px; border-radius: 50%; background: var(--pk-yellow); }
  .quality h2 { margin-bottom: 32px; font-size: var(--text-h2); }
  .intro { color: var(--pk-dark-muted); max-width: 46ch; }
  .quality .eyebrow { color: var(--pk-dark-muted); margin-bottom: 32px; } .quality .eyebrow::before { background: var(--pk-yellow); }
  ul { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 32px; }
  li { display: flex; gap: 16px; padding-block: 8px; }
  /* Items follow the heading one by one, at a wider beat than the default stagger. */
  li { --reveal-delay: calc(var(--motion-stagger) * (3 + var(--item) * 1.5)); }
  .quality-icon { width: 40px; height: 40px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 8px; background: #ffffff14; color: var(--pk-yellow); }
  .quality-icon :global(.icon) { width: 20px; height: 20px; }
  li h3 { font-size: 24px; line-height: 1.3; letter-spacing: -.032em; margin-bottom: 8px; color: var(--pk-white); }
  li p { color: var(--pk-dark-muted); }
  @media (max-width: 900px) {
    .quality-layout { grid-template-columns: 1fr; gap: 40px; }
    .quality-photo { min-height: 0; height: clamp(240px, 56vw, 420px); }
  }
  @media (max-width: 600px) {
    .quality-photo { height: 240px; }
    .quality h2 { margin-bottom: 24px; }
    ul { gap: 20px; }
    li h3 { font-size: 18px; }
    li p { font-size: 15px; }
  }
</style>
