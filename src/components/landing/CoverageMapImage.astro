---
// Illustrated map supplied by design. Illustrative only: the border west of Harrachov and the
// region boundary in this picture do not match ČÚZK data, and it never shows the service area.
// The towns are an SVG overlay in image pixels (src/data/map/illustration-markers.ts), so they stay
// on the baked-in markers at every width; behaviour lives in src/lib/coverage/map-hotspots.ts.
import { Picture } from 'astro:assets';
import mapImage from '../../assets/images/map/krkonose-mapa.png';
import CoverageMapTooltip from './CoverageMapTooltip.astro';
import { illustrationFrame, illustrationMarkers } from '../../data/map/illustration-markers';
import { getPlaceViews, placeGroupLabel } from '../../lib/coverage/place-view';

interface Props { class?: string }
const { class: className } = Astro.props;
const places = getPlaceViews();
const placeNames = places.map(place => place.name).join(', ');
const { width, height } = illustrationFrame;
---
<figure class:list={['coverage-map-image', className]} data-reveal="card" data-coverage-map>
  <Picture
    src={mapImage}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[736, 1104, 1448]}
    sizes="(max-width: 1100px) min(736px, calc(100vw - 40px)), 58vw"
    alt={`Ilustrační mapa Krkonoš a Podkrkonoší s městy ${placeNames}. Vrchlabí je zvýrazněné jako sídlo prádelny. Mapa neukazuje svozovou oblast.`}
    loading="lazy"
    decoding="async"
  />
  <svg class="map-hotspots" viewBox={`0 0 ${width} ${height}`} role="group" aria-label={placeGroupLabel}>
    {places.map(place => {
      const marker = illustrationMarkers[place.id];
      return (
        <g class:list={['hotspot', { 'is-primary': place.primary }]} transform={`translate(${marker.x} ${marker.y})`} role="button" tabindex="0" aria-pressed="false" aria-label={place.accessibleName} data-place={place.id} data-name={place.name} data-status={place.status} data-status-label={place.statusLabel}>
          <circle class="hs-hit" r="40" />
          <circle class="hs-focus" r={marker.r + 19} />
          <g class="hs-mark">
            <circle class="hs-halo" r={marker.r + (place.primary ? 17 : 13)} />
            <circle class="hs-dot" r={marker.r} fill={marker.fill} data-anchor />
          </g>
        </g>
      );
    })}
  </svg>
  <CoverageMapTooltip />
  <figcaption class="map-note">Ilustrační mapa, nikoli hranice svozu.</figcaption>
</figure>
<style>
  .coverage-map-image { position: relative; margin: 0; width: 100%; aspect-ratio: 1448 / 1000; border-radius: 8px; overflow: hidden; background: #f3f5f3; }
  .coverage-map-image :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .map-note { position: absolute; left: 32px; bottom: 20px; margin: 0; color: var(--pk-muted); font-size: 12px; line-height: 1.4; pointer-events: none; }
  /* Same box and aspect ratio as the image, so viewBox units are image pixels. */
  .map-hotspots { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hotspot { cursor: pointer; outline: none; -webkit-tap-highlight-color: transparent; }
  .hs-hit { fill: transparent; }
  .hs-mark { transform-box: fill-box; transform-origin: center; transition: transform 240ms var(--ease-out); }
  /* At rest the overlay is invisible and the baked-in marker shows through; the copy dot takes over on hover. */
  .hs-dot { stroke: var(--pk-white); stroke-width: 3.5; opacity: 0; transition: opacity var(--motion-fast) var(--ease-out), fill var(--motion-fast) var(--ease-out); }
  .hs-halo { fill: var(--pk-yellow); opacity: 0; transition: opacity 240ms var(--ease-out); }
  .hs-focus { fill: none; stroke: var(--pk-teal); stroke-width: 5; opacity: 0; }
  .hotspot.is-selected .hs-mark { transform: scale(1.25); }
  .hotspot.is-selected .hs-dot { opacity: 1; fill: var(--pk-ink); }
  .hotspot.is-selected .hs-halo { opacity: .8; }
  .hotspot:focus-visible .hs-mark { transform: scale(1.4); }
  .hotspot:focus-visible .hs-dot { opacity: 1; }
  .hotspot:focus-visible:not(.is-selected) .hs-halo { opacity: .45; }
  .hotspot:focus-visible .hs-focus { opacity: 1; }
  /* Hover only where it exists; on touch a tap selects instead of leaving a sticky hover. */
  @media (hover: hover) {
    .hotspot:hover .hs-mark { transform: scale(1.4); }
    .hotspot:hover .hs-dot { opacity: 1; }
    .hotspot:hover:not(.is-selected) .hs-halo { opacity: .45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs-mark, .hs-dot, .hs-halo { transition: none; }
    .hotspot .hs-mark, .hotspot:hover .hs-mark, .hotspot:focus-visible .hs-mark, .hotspot.is-selected .hs-mark { transform: none; }
  }
</style>
