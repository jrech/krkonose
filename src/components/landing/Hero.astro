---
import { Image } from 'astro:assets';
import premises from '../../assets/images/premises.webp';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---
<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title" class="is-revealed" data-reveal="heading" style="--reveal-order: 0"><span class="reveal-line">Čisté prádlo včas.</span> <span class="reveal-line">I v plné sezóně.</span></h1>
  <div class="hero-row">
    <p class="lead is-revealed" data-reveal style="--reveal-order: 1">Profesionální praní a svoz prádla pro hotely, penziony a gastro provozy v Krkonoších. Vy se staráte o hosty. My o prádlo.</p>
    <div class="hero-action is-revealed" data-reveal style="--reveal-order: 2">
      <Button href="/kontakt/" arrow={false}>Nezávazná poptávka</Button>
      <a class="hero-phone" href={site.phoneHref}>Zavolejte nám</a>
    </div>
  </div>
  <figure class="hero-image"><div class="hero-photo reveal-frame is-revealed" data-reveal="image" style="--reveal-order: 3"><Image src={premises} alt="Budova prádelny a dodávka Prádelny Krkonoše před vchodem" widths={[480, 720, 1080, 1440, 1920]} sizes="(max-width: 900px) calc(100vw - 40px), calc(100vw - 128px)" format="webp" loading="eager" fetchpriority="high" /></div><figcaption class="is-revealed" data-reveal style="--reveal-order: 4"><span>Místní zázemí. Osobní domluva.</span><a class="text-link" href="#jak-to-funguje">Jak spolupráce funguje ↓</a></figcaption></figure>
</section>
<style>
  /* Entrance runs on load at a slightly slower cadence; the photo wipes in under the headline. The items ship
     already .is-revealed, so the CSS plays from first paint without waiting for reveal.ts (LCP). */
  /* Above the fold: headline, lead and CTA always fit; the photo starts at roughly 60–70 % of the viewport and
     runs on below it, so the first screen invites a scroll. Top spacing and type scale with the viewport height
     (svh) so short laptop screens (~720–800 px) keep the CTA visible and still show a real slice of the photo. */
  .hero { padding-block: clamp(64px, 15svh - 16px, 136px) 96px; --motion-stagger: 120ms; --reveal-base: var(--header-entrance); }
  h1 { font-size: clamp(52px, min(7.6vw, 12.5svh), 112px); line-height: 1.02; letter-spacing: -.04em; font-weight: 500; }
  .hero-row { display: grid; grid-template-columns: minmax(0, 620px) auto; justify-content: space-between; align-items: end; gap: 32px 64px; margin-block: clamp(24px, 4.5svh, 40px) clamp(32px, 5.5svh, 48px); }
  .hero-row .lead { max-width: 56ch; }
  .hero-action :global(.button) { min-width: 288px; }
  .hero-phone { display: none; }
  .hero-image { margin: 0; }
  .hero-photo { border-radius: 8px; --rv-radius: 8px; }
  .hero-image img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center 60%; }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 24px; }
  figcaption a { flex: 0 0 auto; text-decoration: none; padding-block: 6px; margin-block: -6px; }
  figcaption a:hover { text-decoration: underline; }
  @media (max-width: 900px) {
    .hero { padding-block: clamp(56px, 9svh, 96px) 80px; }
    .hero-row { grid-template-columns: 1fr; gap: 24px; margin-block: 24px 32px; }
    .hero-image img { aspect-ratio: 1 / 1; }
  }
  @media (max-width: 600px) {
    .hero { padding-block: clamp(40px, 8svh, 64px) 56px; }
    .hero-row { gap: 20px; margin-block: 20px 24px; }
    h1 { font-size: 44px; line-height: 1.05; }
    .hero-action { display: grid; gap: 8px; }
    .hero-action :global(.button) { min-width: 0; width: 100%; }
    .hero-phone { display: block; justify-self: center; padding: 12px; font-weight: 500; text-decoration: none; }
    .hero-photo { border-radius: 16px; --rv-radius: 16px; }
    .hero-image img { aspect-ratio: 4 / 5; }
    figcaption { align-items: flex-start; flex-direction: column; gap: 8px; padding-top: 16px; font-size: 14px; }
  }
</style>
