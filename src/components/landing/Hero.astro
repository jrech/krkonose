---
import { Image } from 'astro:assets';
import premises from '../../assets/images/premises.webp';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---
<section class="hero container" aria-labelledby="hero-title">
  <p class="eyebrow" data-reveal>Vaše prádelna v Krkonoších</p>
  <h1 id="hero-title" data-reveal="heading"><span class="reveal-line">Čisté prádlo včas.</span> <span class="reveal-line">I v plné sezóně.</span></h1>
  <div class="hero-row">
    <p class="lead" data-reveal>Profesionální praní a svoz prádla pro hotely, penziony a gastro provozy v Krkonoších. Vy se staráte o hosty. My o prádlo.</p>
    <div class="hero-action" data-reveal>
      <Button href="/kontakt/" arrow={false}>Nezávazná poptávka</Button>
      <a class="hero-phone" href={site.phoneHref}>Zavolejte nám</a>
    </div>
  </div>
  <figure class="hero-image"><div class="hero-photo reveal-frame" data-reveal="image"><Image src={premises} alt="Budova prádelny a dodávka Prádelny Krkonoše před vchodem" widths={[480, 720, 1080, 1440, 1920]} sizes="(max-width: 900px) calc(100vw - 40px), calc(100vw - 128px)" format="webp" loading="eager" fetchpriority="high" /></div><figcaption data-reveal><span>Místní zázemí. Osobní domluva.</span><a class="text-link" href="#jak-to-funguje">Jak spolupráce funguje ↓</a></figcaption></figure>
</section>
<style>
  /* Entrance runs on load at a slightly slower cadence; the photo wipes in under the headline. */
  .hero { padding-block: 104px 96px; --motion-stagger: 120ms; --reveal-base: var(--header-entrance); }
  .hero .eyebrow { margin-bottom: 24px; }
  h1 { font-size: clamp(52px, 7.6vw, 112px); line-height: 1.02; letter-spacing: -.04em; font-weight: 500; }
  .hero-row { display: grid; grid-template-columns: minmax(0, 620px) auto; justify-content: space-between; align-items: end; gap: 32px 64px; margin-block: 40px 48px; }
  .hero-row .lead { max-width: 56ch; }
  .hero-action :global(.button) { min-width: 288px; }
  .hero-phone { display: none; }
  .hero-image { margin: 0; }
  .hero-photo { border-radius: 8px; --rv-radius: 8px; }
  .hero-image img { display: block; width: 100%; height: auto; aspect-ratio: 2.6 / 1; object-fit: cover; object-position: center 70%; }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 24px; }
  figcaption a { flex: 0 0 auto; text-decoration: none; padding-block: 6px; margin-block: -6px; }
  figcaption a:hover { text-decoration: underline; }
  @media (max-width: 900px) {
    .hero { padding-block: 72px 80px; }
    .hero-row { grid-template-columns: 1fr; gap: 24px; margin-block: 24px 32px; }
    .hero-image img { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 600px) {
    .hero { padding-block: 56px; }
    h1 { font-size: 44px; line-height: 1.05; }
    .hero-action { display: grid; gap: 8px; }
    .hero-action :global(.button) { min-width: 0; width: 100%; }
    .hero-phone { display: block; justify-self: center; padding: 12px; font-weight: 500; text-decoration: none; }
    .hero-photo { border-radius: 16px; --rv-radius: 16px; }
    .hero-image img { aspect-ratio: 3 / 2; }
    figcaption { align-items: flex-start; flex-direction: column; gap: 8px; padding-top: 16px; font-size: 14px; }
  }
</style>
