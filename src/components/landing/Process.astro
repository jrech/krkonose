---
import { process } from '../../data/site';
---
<section class="process section" id="jak-to-funguje" aria-labelledby="process-title">
  <div class="container">
    <div class="section-heading"><h2 id="process-title" data-reveal="heading"><span class="reveal-line">Tři kroky.</span> <span class="reveal-line h2-soft">A o prádlo je postaráno.</span></h2></div>
    <ol>{process.map((step, index) => <li data-reveal="card"><div class="step-marker" aria-hidden="true"><span class="tile tile--gold">0{index + 1}</span><span class="step-rule"></span></div><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
  </div>
</section>
<style>
  .process { background: var(--pk-paper); padding-block: var(--section-space-l); }
  h2 { margin: 0; }
  .h2-soft { color: #3c6862; }
  ol { list-style: none; padding: 0; margin: clamp(40px, 3.9vw, 56px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 2.8vw, 40px); }
  .step-marker { display: flex; align-items: center; gap: 20px; margin-bottom: 16px; }
  .step-rule { flex: 1 1 auto; height: 1px; background: #ceddd3; transform-origin: left center; }
  /* The rule draws out from the number as its step reveals. */
  :global(.motion) li:global(.is-revealed) .step-rule { animation: step-rule var(--motion-rule, 1400ms) var(--ease-rule, cubic-bezier(.455, .03, .515, .955)) calc(var(--rv-delay, 0ms) + 120ms) backwards; }
  @keyframes step-rule { from { transform: scaleX(0); } }
  h3 { margin-bottom: 16px; font-size: 23px; line-height: 30px; letter-spacing: -.026em; font-weight: 600; }
  li p { font-size: 17px; line-height: 27px; color: #5a7068; max-width: 44ch; }
  @media (max-width: 900px) {
    ol { grid-template-columns: 1fr; gap: 40px; }
    li p { max-width: 48ch; }
  }
  @media (max-width: 760px) {
    ol { margin-top: 40px; gap: 32px; }
    .step-marker { gap: 16px; margin-bottom: 16px; }
    h3 { font-size: 20px; }
    li p { font-size: 16px; }
  }
</style>
