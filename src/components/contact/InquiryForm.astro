---
import { site } from '../../data/site';
import { segments } from '../../data/segments';
import Icon from '../ui/Icon.astro';
const operations = [...segments.map(segment => ({ id: segment.id, label: segment.inquiry })), { id: 'jiny', label: 'Jiný provoz' }];
---
<div class="inquiry-card">
  <!-- Without JS the browser posts straight to Formspree (native validation applies) and shows its thank-you page.
       With JS the script takes over: own validation, fetch, and the result panel below. -->
  <form id="inquiry-form" class="inquiry-form" method="post" action={site.inquiryEndpoint} aria-labelledby="inquiry-title" data-email={site.email} data-endpoint={site.inquiryEndpoint}>
    <input type="hidden" name="_subject" value="Poptávka spolupráce z webu" />
    <div class="form-head">
      <h2 id="inquiry-title">Napište nám</h2>
      <p>Stačí pár základních údajů. Podrobnosti probereme společně.</p>
    </div>
    <div class="form-error" id="form-error" role="alert" tabindex="-1" hidden></div>
    <div class="field-row">
      <div class="field">
        <label for="inquiry-name">Jméno a provozovna *</label>
        <input id="inquiry-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Jak vás oslovit" aria-describedby="inquiry-name-error" />
        <p class="field-error" id="inquiry-name-error" hidden></p>
      </div>
      <div class="field">
        <label for="inquiry-contact">Telefon nebo e-mail *</label>
        <input id="inquiry-contact" name="contact" type="text" autocomplete="email" required maxlength="120" placeholder="Jak se vám ozvat" aria-describedby="inquiry-contact-hint inquiry-contact-error" />
        <p class="field-hint" id="inquiry-contact-hint">Stačí jeden údaj, druhý domluvíme později.</p>
        <p class="field-error" id="inquiry-contact-error" hidden></p>
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="inquiry-locality">Obec / adresa provozu *</label>
        <input id="inquiry-locality" name="locality" type="text" autocomplete="street-address" required maxlength="180" placeholder="Kde působíte?" aria-describedby="inquiry-locality-error" />
        <p class="field-error" id="inquiry-locality-error" hidden></p>
      </div>
      <div class="field">
        <label for="inquiry-operation">Typ provozu</label>
        <div class="select-wrap">
          <select id="inquiry-operation" name="operation">
            <option value="">Vyberte typ provozu</option>
            {operations.map(item => <option value={item.label} data-id={item.id}>{item.label}</option>)}
          </select>
        </div>
      </div>
    </div>
    <div class="field">
      <label for="inquiry-details">Co potřebujete prát? <span class="optional">(nepovinné)</span></label>
      <textarea id="inquiry-details" name="details" rows="4" maxlength="2000" placeholder="Např. ložní prádlo, ručníky a přibližná četnost svozu…"></textarea>
    </div>
    <!-- Spam trap: hidden from people and assistive tech, bots tend to fill it. Formspree drops submissions with _gotcha set. -->
    <div class="trap" aria-hidden="true"><label for="inquiry-website">Web</label><input id="inquiry-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" /></div>
    <div class="form-submit">
      <button class="button" type="submit"><span class="button-label"><span class="button-label-text">Odeslat poptávku</span></span></button>
      <p class="required-note">* Povinné údaje</p>
    </div>
    <p class="privacy-note">Údaje použijeme jen k vyřízení vaší poptávky. <a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></p>
  </form>

  <div class="form-result" id="form-result" tabindex="-1" aria-live="polite" hidden>
    <span class="result-icon"><Icon name="mail" /></span>
    <h2 id="result-title"></h2>
    <p id="result-text"></p>
    <div class="result-actions">
      <a class="button" id="result-mail" hidden><span class="button-label"><span class="button-label-text">Otevřít e-mail znovu</span></span></a>
      <button class="button button--secondary" type="button" id="result-back"><span class="button-label"><span class="button-label-text">Upravit poptávku</span></span></button>
    </div>
  </div>
</div>

<script>
  import { formatInquiry, getInquiryTransport, validateInquiry, type Inquiry, type InquiryField } from '../../lib/inquiry/inquiry';
  import { trackEvent } from '../../lib/consent/analytics';

  const form = document.querySelector<HTMLFormElement>('#inquiry-form');
  const result = document.querySelector<HTMLElement>('#form-result');
  if (form && result) {
    const email = form.dataset.email || '';
    const transport = getInquiryTransport(form.dataset.endpoint || '', email);
    form.noValidate = true;
    const summary = form.querySelector<HTMLElement>('#form-error')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.querySelector('.button-label-text') ?? submit;
    const fields: InquiryField[] = ['name', 'contact', 'locality'];
    const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

    // Prefill from landing CTAs: /kontakt/?provoz=hotely&lokalita=Vrchlabí
    const params = new URLSearchParams(location.search);
    const locality = params.get('lokalita')?.trim().slice(0, 180);
    if (locality) input('locality').value = locality;
    const operation = params.get('provoz')?.trim().toLowerCase();
    if (operation) {
      const select = input('operation') as unknown as HTMLSelectElement;
      const match = [...select.options].find(option => option.dataset.id === operation || option.value.toLowerCase() === operation);
      if (match) select.value = match.value;
    }

    const read = (): Inquiry => ({
      name: input('name').value, contact: input('contact').value, locality: input('locality').value,
      operation: input('operation').value, details: input('details').value,
    });

    function showErrors(errors: Partial<Record<InquiryField, string>>) {
      fields.forEach(field => {
        const control = input(field);
        const message = form!.querySelector<HTMLElement>(`#inquiry-${field}-error`)!;
        const error = errors[field];
        if (error) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
        message.hidden = !error;
        message.textContent = error ?? '';
      });
    }

    // Re-validate a touched field as the visitor fixes it, but never shout before the first submit.
    let attempted = false;
    fields.forEach(field => input(field).addEventListener('input', () => {
      if (!attempted) return;
      const errors = validateInquiry(read());
      showErrors(errors);
      if (!Object.keys(errors).length) summary.hidden = true;
    }));

    function showResult(title: string, text: string, mailHref?: string) {
      const mail = result!.querySelector<HTMLAnchorElement>('#result-mail')!;
      result!.querySelector('#result-title')!.textContent = title;
      result!.querySelector('#result-text')!.textContent = text;
      mail.hidden = !mailHref;
      if (mailHref) mail.href = mailHref;
      form!.hidden = true;
      result!.hidden = false;
      result!.focus();
    }

    result.querySelector('#result-back')!.addEventListener('click', () => {
      result.hidden = true;
      form.hidden = false;
      input('name').focus();
    });

    form.addEventListener('submit', async event => {
      event.preventDefault();
      attempted = true;
      if (input('_gotcha').value) return;
      const inquiry = read();
      const errors = validateInquiry(inquiry);
      showErrors(errors);
      const invalid = fields.filter(field => errors[field]);
      if (invalid.length) {
        summary.textContent = invalid.length === 1 ? 'Jeden údaj je potřeba opravit.' : `${invalid.length} údaje je potřeba opravit.`;
        summary.hidden = false;
        input(invalid[0]).focus();
        return;
      }
      summary.hidden = true;
      submit.disabled = true;
      submitLabel.textContent = 'Odesílám…';
      try {
        const outcome = await transport.submit(inquiry);
        if (outcome.delivery === 'form-post') {
          // Same as the no-JS path: Formspree takes over (spam check, then its thank-you page).
          (form.querySelector('[name="_subject"]') as HTMLInputElement).value = formatInquiry(inquiry).subject;
          HTMLFormElement.prototype.submit.call(form);
          return;
        }
        if (outcome.delivery === 'mail-app') {
          window.location.href = outcome.href;
          showResult(
            'Poptávka je připravená v e-mailu',
            `Otevřeli jsme váš e-mailový program s vyplněnou zprávou. Poptávka dorazí, až ji tam odešlete. Pokud se nic neotevřelo, napište nám na ${email} nebo zavolejte.`,
            outcome.href,
          );
        } else {
          form.reset();
          // Counted only here, after Formspree confirmed delivery. No form content goes to GA.
          trackEvent('generate_lead', { form_name: 'poptavka' });
          showResult('Děkujeme, poptávka je odeslaná', 'Ozveme se vám na uvedený kontakt a společně probereme rozsah i svoz.');
        }
      } catch {
        summary.textContent = `Poptávku se nepodařilo odeslat. Zkuste to prosím znovu, nebo nám napište na ${email} či zavolejte.`;
        summary.hidden = false;
        summary.focus();
      } finally {
        submit.disabled = false;
        submitLabel.textContent = 'Odeslat poptávku';
      }
    });
  }
</script>

<style>
  .inquiry-card { background: var(--pk-white); border: 1px solid var(--pk-line); border-radius: 12px; padding: 48px; }
  .inquiry-form, .form-result { display: grid; gap: 32px; }
  .form-head { display: grid; gap: 8px; }
  .inquiry-card h2 { font-size: 32px; line-height: 1.19; letter-spacing: -.033em; }
  .form-head p, .field-hint, .required-note, .privacy-note { color: var(--pk-muted); }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .field { display: grid; gap: 8px; align-content: start; }
  label { font-size: 14px; line-height: 20px; }
  .optional { color: var(--pk-muted); }
  input, select, textarea { width: 100%; min-height: 56px; padding: 14px 16px; border: 1px solid #b9cdca; border-radius: 6px; background: var(--pk-white); color: var(--pk-ink); font: inherit; font-size: 16px; line-height: 26px; transition: border-color 180ms ease; }
  textarea { min-height: 116px; resize: vertical; }
  input::placeholder, textarea::placeholder { color: var(--pk-muted); opacity: 1; }
  input:hover, select:hover, textarea:hover { border-color: var(--pk-teal); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--pk-teal); outline-offset: 1px; border-color: var(--pk-teal); }
  [aria-invalid='true'] { border-color: var(--pk-error); }
  .select-wrap { position: relative; }
  .select-wrap::after { content: ''; position: absolute; right: 20px; top: 50%; width: 8px; height: 8px; border-right: 1.7px solid var(--pk-teal); border-bottom: 1.7px solid var(--pk-teal); transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  select { appearance: none; padding-right: 48px; cursor: pointer; }
  .field-hint { font-size: 12px; line-height: 17px; }
  .field-error { color: var(--pk-error); font-size: 14px; line-height: 20px; }
  .form-error { padding: 12px 16px; border-left: 3px solid var(--pk-error); border-radius: 6px; background: #b638380f; color: var(--pk-error); font-size: 14px; line-height: 20px; }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-submit { display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .form-submit .button { padding-inline: 32px; }
  .form-submit .button:disabled { background: var(--pk-line); color: var(--pk-muted); cursor: progress; }
  .required-note, .privacy-note { font-size: 12px; line-height: 17px; }
  .privacy-note { margin-top: -8px; }
  .privacy-note a { color: var(--pk-teal); text-underline-offset: 3px; }
  .privacy-note a:hover { color: var(--pk-teal-hover); }
  .form-result { justify-items: start; gap: 24px; }
  .form-result:focus { outline: none; }
  .result-icon { display: inline-flex; padding: 12px; border-radius: 8px; background: #087f8614; color: var(--pk-success); }
  .form-result p { max-width: 56ch; color: var(--pk-muted); }
  .result-actions { display: flex; flex-wrap: wrap; gap: 16px; }
  @media (max-width: 760px) {
    .inquiry-card { padding: 24px; }
    .inquiry-card h2 { font-size: 28px; }
    .field-row { grid-template-columns: 1fr; }
    .form-submit { flex-direction: column; align-items: stretch; gap: 16px; }
    .form-submit .button { width: 100%; }
  }
</style>
