---
import { navigation, site } from '../data/site';
import Icon from './ui/Icon.astro';
import Button from './ui/Button.astro';
---
<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="#uvod" aria-label="Prádelna Krkonoše — úvod"><img src="/logo.svg" alt="Prádelna Krkonoše" width="129" height="66" /></a>
    <nav class="desktop-nav" aria-label="Hlavní navigace">{navigation.map(item => <a class="link-line" href={item.href}>{item.short ?? item.label}</a>)}</nav>
    <a class="header-phone" href={site.phoneHref} aria-label={`Zavolat na ${site.phone}`}>
      <Icon name="phone" /><span>{site.phone}</span>
    </a>
    <button class="menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="Otevřít menu" hidden><Icon name="menu" /><span>Menu</span></button>
  </div>
  <nav id="mobile-nav" class="mobile-nav container" aria-label="Mobilní navigace" hidden>
    {navigation.map((item, i) => <a href={item.href} style={`--i: ${i}`}>{item.label}<Icon name="arrow-up-right" /></a>)}
    <Button href="/kontakt/" style={`--i: ${navigation.length}`}>Nezávazná poptávka</Button>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#mobile-nav');
  const desktop = matchMedia('(min-width: 1200px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (toggle && nav) {
    toggle.hidden = false;
    document.documentElement.classList.add('nav-ready');
    // Closing plays menu-out first and hides the panel when it ends; the timer covers a missed animationend.
    let closeTimer = 0;
    const finishClose = () => { if (!nav || nav.dataset.state !== 'closing') return; clearTimeout(closeTimer); nav.hidden = true; delete nav.dataset.state; };
    nav.addEventListener('animationend', event => { if (event.target === nav && event.animationName.includes('menu-out')) finishClose(); });
    function setOpen(open: boolean) {
      if (!toggle || !nav) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      clearTimeout(closeTimer);
      if (open) { delete nav.dataset.state; nav.hidden = false; return; }
      if (nav.hidden) return;
      if (reduced.matches || desktop.matches) { nav.dataset.state = 'closing'; finishClose(); return; }
      nav.dataset.state = 'closing';
      closeTimer = window.setTimeout(finishClose, 400);
    }
    function closeMenu(restoreFocus = false) {
      setOpen(false);
      if (restoreFocus) toggle?.focus();
    }
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', event => { if ((event.target as Element).closest('a')) closeMenu(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') closeMenu(true); });
    desktop.addEventListener('change', event => { if (event.matches) closeMenu(); });
  }
</script>
<style>
  .site-header { border-bottom: 1px solid var(--pk-line); background: var(--pk-paper); }
  .header-inner { display: flex; align-items: center; justify-content: flex-end; gap: 32px; min-height: 104px; }
  .brand { margin-right: auto; }
  .brand { flex: 0 0 auto; } .brand img { width: 97px; height: auto; }
  .desktop-nav { display: flex; align-items: center; gap: 24px; }
  .desktop-nav a { font-size: 16px; font-weight: 400; white-space: nowrap; padding-block: 2px; }
  .desktop-nav a:hover { color: var(--pk-teal); }
  .header-phone { min-height: 56px; padding-left: 32px; border-left: 1px solid var(--pk-line); display: inline-flex; align-items: center; gap: 8px; font-size: 14px; text-decoration: none; white-space: nowrap; }
  .header-phone :global(.icon) { width: 20px; height: 20px; color: var(--pk-teal); }
  .header-phone { transition: color var(--motion-hover) var(--ease-out); }
  .header-phone:hover { color: var(--pk-teal); }
  .menu-toggle { border: 1px solid var(--pk-line); border-radius: 8px; padding: 12px; background: transparent; color: var(--pk-ink); align-items: center; gap: 8px; cursor: pointer; font: inherit; }
  .menu-toggle[hidden], .mobile-nav[hidden] { display: none; }
  /* Overlays the page below the sticky bar, so opening it never pushes content. */
  .mobile-nav { position: absolute; top: 100%; left: 0; right: 0; width: auto; margin: 0; padding: 16px var(--gutter) 32px; background: inherit; border-bottom: 1px solid var(--pk-line); box-shadow: 0 24px 40px -32px rgb(9 46 50 / .45); max-height: calc(100dvh - var(--header-h, 98px)); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-nav > a:not(.button) { position: relative; display: flex; justify-content: space-between; padding: 16px 0; text-decoration: none; font-weight: 500; transition: color var(--motion-hover) var(--ease-out); }
  /* Separator as a pseudo-element so it can draw in from the left when the menu opens. */
  .mobile-nav > a:not(.button)::before { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: var(--pk-line); transform-origin: left; }
  .mobile-nav > a:not(.button):hover { color: var(--pk-teal); }
  .mobile-nav :global(.button) { margin-top: 16px; }
  /* Hamburger folds into a cross while the menu is open. */
  .menu-toggle :global(path) { transform-box: view-box; transform-origin: 12px 12px; transition: transform 450ms var(--ease-out), opacity 200ms var(--ease-out); }
  .menu-toggle[aria-expanded="true"] :global(path:nth-child(1)) { transform: rotate(45deg) translateY(7px); }
  .menu-toggle[aria-expanded="true"] :global(path:nth-child(2)) { opacity: 0; transform: scaleX(.2); }
  .menu-toggle[aria-expanded="true"] :global(path:nth-child(3)) { transform: rotate(-45deg) translateY(-7px); }
  /* Open: the panel unrolls from under the bar, then rows rise in one by one and their lines draw across.
     Close: one quick fold upwards. Reduced motion skips all of it (global.css), and the script closes at once. */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav:not([hidden]) { animation: menu-in 560ms var(--ease-out); }
    .mobile-nav:not([hidden]) > :global(*) { --rv-delay: calc(90ms + var(--i, 0) * 45ms); animation: menu-item-in var(--motion-text) var(--ease-out) var(--rv-delay) backwards; }
    .mobile-nav:not([hidden]) > a:not(.button)::before { animation: menu-line-in calc(var(--motion-text) + 250ms) var(--ease-out) var(--rv-delay) backwards; }
    .mobile-nav[data-state="closing"] { pointer-events: none; animation: menu-out 260ms cubic-bezier(.4, 0, .6, 1) forwards; }
    .mobile-nav[data-state="closing"] > :global(*), .mobile-nav[data-state="closing"] > a::before { animation: none; }
  }
  @keyframes menu-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 -64px 0); } }
  @keyframes menu-out { from { clip-path: inset(0 0 -64px 0); } to { clip-path: inset(0 0 100% 0); opacity: .6; } }
  @keyframes menu-item-in { from { opacity: 0; transform: translate3d(0, calc(var(--motion-shift-text) * -1.2), 0); } }
  @keyframes menu-line-in { from { transform: scaleX(0); } }
  @media (min-width: 1200px) { .menu-toggle { display: none; } }
  @media (max-width: 1199px) {
    .header-inner { flex-wrap: wrap; padding-block: 12px; }
    .desktop-nav { order: 3; flex-basis: 100%; flex-wrap: wrap; padding-bottom: 8px; }
    :global(.nav-ready) .desktop-nav { display: none; }
    .menu-toggle:not([hidden]) { display: inline-flex; }
    .header-phone { margin-left: auto; padding-left: 16px; }
  }
  @media (max-width: 600px) { .header-inner { min-height: 98px; } .header-phone { display: none; } }
</style>
