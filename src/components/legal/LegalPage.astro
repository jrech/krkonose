---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactHeader from '../contact/ContactHeader.astro';
import SiteFooter from '../SiteFooter.astro';
// Shared shell for text pages (legal, LLM info): sub-page header, intro, optional contents list, prose body.
// Sections inside the slot are plain <section id> blocks with an <h2>; .prose styles them.
interface Props {
  title: string;
  eyebrow: string;
  heading: string[];
  lead: string;
  updated?: string;
  toc?: { id: string; label: string }[];
}
const { title, eyebrow, heading, lead, updated, toc = [] } = Astro.props;
---
<BaseLayout title={title}>
  <ContactHeader current={false} />
  <main id="main">
    <section class="legal-intro container" aria-labelledby="legal-title">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <div class="intro-row">
        <h1 id="legal-title" data-reveal="heading">{heading.map(line => <span class="reveal-line">{line}</span>)}</h1>
        <div class="intro-side" data-reveal>
          <p class="lead">{lead}</p>
          {updated && <p class="updated">Poslední aktualizace: {updated}</p>}
        </div>
      </div>
    </section>
    <div class:list={['legal-body container', { 'has-toc': toc.length }]}>
      {toc.length > 0 && (
        <nav class="toc" aria-labelledby="toc-title" data-reveal>
          <p id="toc-title" class="toc-title">Obsah</p>
          <ol>{toc.map((item, i) => <li><a href={`#${item.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{item.label}</a></li>)}</ol>
        </nav>
      )}
      <article class="prose" data-reveal="card"><slot /></article>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .legal-intro { padding-block: 80px 64px; --reveal-base: var(--header-entrance); border-bottom: 1px solid var(--pk-line); }
  .legal-intro .eyebrow { margin-bottom: 24px; }
  .intro-row { display: grid; grid-template-columns: minmax(0, 1fr) 380px; align-items: end; gap: 80px; }
  h1 { font-size: var(--text-display); line-height: 1.05; letter-spacing: -.0245em; font-weight: 500; }
  .intro-side { display: grid; gap: 16px; }
  .updated { color: var(--pk-muted); font-size: 14px; line-height: 20px; }
  .legal-body { display: grid; grid-template-columns: minmax(0, 760px); padding-block: 64px var(--section-space); }
  .legal-body.has-toc { grid-template-columns: 260px minmax(0, 760px); gap: clamp(48px, 8vw, 120px); }
  .toc { position: sticky; top: calc(var(--header-h, 104px) + 32px); align-self: start; display: grid; gap: 16px; }
  .toc-title { font-size: 14px; line-height: 20px; letter-spacing: .08em; text-transform: uppercase; color: var(--pk-muted); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; border-left: 1px solid var(--pk-line); }
  .toc a { display: flex; gap: 12px; padding: 6px 0 6px 16px; margin-left: -1px; border-left: 2px solid transparent; font-size: 16px; line-height: 24px; text-decoration: none; transition: color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out); }
  .toc a span { color: var(--pk-teal); font-size: 12px; line-height: 24px; }
  .toc a:hover { color: var(--pk-teal); border-left-color: var(--pk-teal); }

  .prose { display: grid; gap: 56px; }
  .prose :global(section) { display: grid; gap: 16px; scroll-margin-top: calc(var(--header-h, 104px) + 24px); }
  .prose :global(section + section) { padding-top: 56px; border-top: 1px solid var(--pk-line); }
  .prose :global(h2) { font-size: 32px; line-height: 1.19; letter-spacing: -.035em; margin-bottom: 8px; }
  .prose :global(h3) { font-size: 20px; line-height: 1.4; letter-spacing: -.01em; margin-top: 8px; }
  .prose :global(p), .prose :global(li) { color: var(--pk-ink); max-width: 68ch; }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 8px; }
  .prose :global(ul li) { position: relative; padding-left: 24px; }
  .prose :global(ul li::before) { content: ""; position: absolute; left: 0; top: .78em; width: 12px; height: 2px; background: var(--pk-teal); }
  .prose :global(ol.steps) { counter-reset: step; }
  .prose :global(ol.steps li) { counter-increment: step; display: flex; gap: 12px; align-items: baseline; }
  .prose :global(ol.steps li::before) { content: "0" counter(step); flex: 0 0 32px; color: var(--pk-teal); font-size: 12px; }
  .prose :global(a) { color: var(--pk-teal); text-underline-offset: 5px; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .prose :global(a:hover) { color: var(--pk-teal-hover); }
  .prose :global(.note) { padding: 24px; border-radius: 12px; background: var(--pk-white); border: 1px solid var(--pk-line); color: var(--pk-muted); }
  .prose :global(dl) { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--pk-line); }
  .prose :global(dl > div) { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px; padding-block: 12px; border-bottom: 1px solid var(--pk-line); }
  .prose :global(dt) { font-size: 12px; line-height: 24px; letter-spacing: 1px; text-transform: uppercase; color: var(--pk-muted); }
  .prose :global(dd) { margin: 0; }

  @media (max-width: 1100px) {
    .legal-body.has-toc { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .toc { position: static; }
  }
  @media (max-width: 900px) {
    .legal-intro { padding-block: 64px 48px; }
    .intro-row { grid-template-columns: 1fr; gap: 24px; }
    h1 { font-size: clamp(44px, 8vw, 64px); line-height: 1.1; }
  }
  @media (max-width: 760px) {
    .legal-body { padding-top: 48px; }
    .prose { gap: 40px; }
    .prose :global(section + section) { padding-top: 40px; }
    .prose :global(h2) { font-size: 28px; }
    .prose :global(dl > div) { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
