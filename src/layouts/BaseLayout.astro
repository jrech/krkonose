---
import '../styles/global.css';
import { site } from '../data/site';
import CookieConsent from '../components/consent/CookieConsent.astro';
import { getImage } from 'astro:assets';
import social from '../assets/images/delivery.webp';
interface Props { title?: string }
const { title = 'Prádelna Krkonoše | Čisté prádlo pro váš provoz' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = await getImage({ src: social, width: 1200, height: 630, format: 'jpeg' });
const imageUrl = Astro.site ? new URL(socialImage.src, Astro.site) : undefined;
---
<!doctype html>
<html lang="cs"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={site.description} /><meta name="theme-color" content="#092e32" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="preload" href="/fonts/rethink-sans-500.ttf" as="font" type="font/ttf" crossorigin />
  <script is:inline>(() => { const d = document.documentElement; d.classList.add('nav-ready'); /* collapse the header menu before first paint (SiteHeader) */ if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return; d.classList.add('motion'); setTimeout(() => { if (!d.classList.contains('motion-live')) d.classList.remove('motion'); }, 2500); })();</script>
  {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" /><meta property="og:locale" content="cs_CZ" /><meta property="og:site_name" content={site.name} /><meta property="og:title" content={title} /><meta property="og:description" content={site.description} />
  {canonical && <meta property="og:url" content={canonical} />}{imageUrl && <><meta property="og:image" content={imageUrl} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Ilustrační fotografie čistého složeného prádla" /></>}
  <meta name="twitter:card" content="summary_large_image" />
  {canonical && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: Astro.site, telephone: site.phone, email: site.email }).replace(/</g, '\\u003c')} />}
</head><body id="uvod"><a class="skip-link" href="#main">Přejít na obsah</a><slot /><CookieConsent /><script>import '../scripts/header'; import '../scripts/reveal';</script></body></html>
